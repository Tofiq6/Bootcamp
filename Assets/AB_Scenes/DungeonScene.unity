--- !u!114 &396589336
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 396589335}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 624e549c1d4a98e4faec03a65f67aa4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  animator: {fileID: 396589338}
  audioSource: {fileID: 396589339}
  subtitleText: {fileID: 1128160910}
  actionPromptText: {fileID: 1196481021}
  efsunText: {fileID: 0}
  trigger: {fileID: 406841659}
  Bilge: 0
  Kaptan: 0
  Amara: 0
  Fiona: 0
  dialogues:
  - audio: {fileID: 8300000, guid: 33f0b33c49a59fa47bee6fb45ddb8691, type: 3}
    subtitle: "Evlat, hayatta denge her \u015Feyin anahtar\u0131d\u0131r, bazen a\u011F\u0131r,
      bazen hafif, bu belli olur."
    npcTalks: 1
    subtitleDuration: 9
  - audio: {fileID: 8300000, guid: 2deeecba7d7ced24f952a9fd36982724, type: 3}
    subtitle: "Her iki taraf\u0131 dikkatle tart, biri \xE7ok g\xFC\xE7l\xFC olursa,
      di\u011Feri ba\u011Flan\u0131r."
    npcTalks: 1
    subtitleDuration: 7
  - audio: {fileID: 8300000, guid: 1ad853538badc4e4a98f2ca038306547, type: 3}
    subtitle: "Bazen g\xFC\xE7 ve cesaret yol g\xF6sterir, bazen de huzur ve sab\u0131r
      rehber olur."
    npcTalks: 1
    subtitleDuration: 5
  - audio: {fileID: 8300000, guid: 7e9e1500b6addf1499f43bb2d210fb2c, type: 3}
    subtitle: "Ama denge zarafetle bulundu\u011Funda, hayat yerli yerine oturur,
      m\xFCkemmel bir d\xFCzen kurulur."
    npcTalks: 1
    subtitleDuration: 6
