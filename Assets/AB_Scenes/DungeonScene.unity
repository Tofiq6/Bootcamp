  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2af7f84b5f5663e4ba4a621dbfc12334, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sequence:
  - audioClip: {fileID: 8300000, guid: 79b17cda35753a94fa71cc0e92409acf, type: 3}
    subtitleText: " Geciktin, Kael. Sevgili e\u015Finin senin i\xE7in daha de\u011Ferli
      oldu\u011Funu d\xFC\u015F\xFCn\xFCyordum... "
  - audioClip: {fileID: 8300000, guid: fafa8847ac403f54ba0a1b84dff4662b, type: 3}
    subtitleText: "E\u011Fer ona zarar verdiysen... seni yok ederim. "
  - audioClip: {fileID: 8300000, guid: 73e1bdca2ffdda143976310dc62bb924, type: 3}
    subtitleText: "A\u015Fk, ne b\xFCy\xFCk bir zay\u0131fl\u0131k."
  - audioClip: {fileID: 8300000, guid: ea347029f273c0c4e945ae97c31d1578, type: 3}
    subtitleText: "Ben zay\u0131f de\u011Filim. Lyra\u2019n\u0131n \u0131\u015F\u0131\u011F\u0131yla
      seni karanl\u0131\u011Fa g\xF6mece\u011Fim."
  subtitleTextUI: {fileID: 1128160910}
  audioSource: {fileID: 1254012287}
  vfxObject: {fileID: 1496792694}
  finalGameObject: {fileID: 710723929}
