  m_Name: 
  m_EditorClassIdentifier: 
  animator: {fileID: 545369258}
  audioSource: {fileID: 545369259}
  subtitleText: {fileID: 1128160910}
  actionPromptText: {fileID: 1196481021}
  efsunText: {fileID: 0}
  trigger: {fileID: 646373687}
  Bilge: 0
  Kaptan: 0
  Amara: 0
  Fiona: 1
  dialogues:
  - audio: {fileID: 8300000, guid: 014dae02a7e053f4e90704343388fb74, type: 3}
    subtitle: "Selam yak\u0131\u015F\u0131kl\u0131, Bu topraklarda her biri e\u015Fsiz
      bir g\xFC\xE7 ve ama\xE7 ta\u015F\u0131yan be\u015F kahraman vard\u0131"
    npcTalks: 1
    subtitleDuration: 8
  - audio: {fileID: 8300000, guid: 4425cbbc483ab684883a1e24393b217c, type: 3}
    subtitle: "Topra\u011F\u0131n g\xFCc\xFCn\xFC ta\u015F\u0131yan ilk ad\u0131m\u0131
      atar"
    npcTalks: 1
    subtitleDuration: 3
  - audio: {fileID: 8300000, guid: af3a0996c83adb0498eb29faaf50a417, type: 3}
    subtitle: "G\xF6ky\xFCz\xFCne cesurca y\xFCkselmek isteyen sonra gelir"
    npcTalks: 1
    subtitleDuration: 4
  - audio: {fileID: 8300000, guid: 9598b3deba2239b45a7f64b4f93ec6d6, type: 3}
    subtitle: " Orman\u0131n kral\u0131 ard\u0131ndan g\xFCc\xFCn\xFC g\xF6sterir"
    npcTalks: 1
    subtitleDuration: 4
  - audio: {fileID: 8300000, guid: befab73f9c83fc0438611f7433a08ec6, type: 3}
    subtitle: " Yaln\u0131z bir yolcu, \xF6zg\xFCrl\xFC\u011F\xFCn\xFC arayan bir
      ba\u015Fka ad\u0131m atar"
    npcTalks: 1
    subtitleDuration: 4
  - audio: {fileID: 8300000, guid: 4fe0ee6e08c58d34abe32b2fc16a0c1d, type: 3}
    subtitle: "Sonunda huzurun zarif \xE7i\xE7e\u011Fi do\u011Far, do\u011Fa ile
      uyum i\xE7inde"
    npcTalks: 1
    subtitleDuration: 6
